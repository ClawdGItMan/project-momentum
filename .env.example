# Project Momentum local env
#
# Backend secrets stay server-only. Expo public vars are safe to expose to the
# mobile client and should use the `EXPO_PUBLIC_` prefix.

# Expo / mobile client
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
EXPO_PUBLIC_USE_SEEDED_DEMO=false

# Backend and local developer tooling only

NODE_ENV=development

# Core backend
# For hosted Supabase pooler access during local development, use the project
# pooler URL and append `?sslmode=no-verify` if your local machine cannot
# validate the certificate chain yet. Keep stricter SSL verification in hosted
# environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/project_momentum
BACKEND_PUBLIC_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:8081
PORT=8787
LOG_LEVEL=info
QUEUE_SCHEMA=job_queue

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Session / secret handling
SESSION_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY_ID=current
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-a-32-byte-base64-key
WEBHOOK_MAX_AGE_SECONDS=300

# Apple Health upload gate for normalized device summaries
APPLE_HEALTH_UPLOAD_SHARED_SECRET=replace-me

# Strava server-side OAuth + webhook flow
STRAVA_CLIENT_ID=replace-me
STRAVA_CLIENT_SECRET=replace-me
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-me

# WHOOP server-side OAuth + webhook flow
WHOOP_CLIENT_ID=replace-me
WHOOP_CLIENT_SECRET=replace-me
WHOOP_WEBHOOK_VERIFY_TOKEN=replace-me
WHOOP_WEBHOOK_SECRET=replace-me
